# --- Required -----------------------------------------------------------
# Public URL users reach the app at (no trailing slash). Redirect URI = BASE_URL/auth/callback
BASE_URL=https://games.example.com
# openssl rand -hex 32
SECRET_KEY=
TIMEZONE=America/New_York
APP_NAME=Game Night

# --- Authentik OIDC login ------------------------------------------------
# Authentik shows this as "OpenID Configuration Issuer" on the provider page
OIDC_ISSUER=https://auth.example.com/application/o/boardgames/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
# Members of this Authentik group are admins in the app
OIDC_ADMIN_GROUP=Board Game Admins
# Optional: reject logins not in this group (prefer an Authentik policy binding on the application)
OIDC_ALLOWED_GROUP=

# --- Authentik user sync (player roster) ---------------------------------
AUTHENTIK_URL=https://auth.example.com
AUTHENTIK_TOKEN=
# Only members of this group show up as players. Empty = all internal + external users
AUTHENTIK_GROUP=Board Gamers
# Must match the provider's "Subject mode". Default in Authentik is hashed_user_id
AUTHENTIK_SUB_MODE=hashed_user_id
AUTHENTIK_SYNC_INTERVAL_MINUTES=60
AUTHENTIK_VERIFY_TLS=true

# --- Database --------------------------------------------------------------
# Default is SQLite on the /data volume. For Postgres:
# DATABASE_URL=postgresql+psycopg://boardgames:password@db:5432/boardgames
